# Copiá a .env y completá. NUNCA commitees .env.
POSTGRES_DB=trina
POSTGRES_USER=trina
POSTGRES_PASSWORD=CAMBIA-ESTO-min-16-chars
MINIO_ROOT_USER=trina-minio
MINIO_ROOT_PASSWORD=CAMBIA-ESTO-min-16-chars
MINIO_BUCKET=trina-media
JWT_SECRET=CAMBIA-ESTO-min-32-bytes-para-HS256-usa-openssl-rand-hex-32
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081
# Admin inicial (prod: obligatorio; demo: opcional, con APP_SEED_DEMO=true vale admin1234)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Demo (hito §8.2): true carga dataset + permite clave demo
APP_SEED_DEMO=false
# Almacenamiento: local (dev sin MinIO, por defecto) | minio (requiere perfil `minio` + licencia AIStor)
APP_STORAGE=local
# Correo dev: maildev sin auth. Para Gmail prod pon MAIL_HOST=smtp.gmail.com, MAIL_PORT=587,
# MAIL_USERNAME=monedero.virtual20251@gmail.com, MAIL_PASSWORD=<app-password Gmail, nunca al repo>,
# MAIL_SMTP_AUTH=true, MAIL_SMTP_STARTTLS=true
MAIL_HOST=maildev
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
APP_CORREO_REMITENTE=monedero.virtual20251@gmail.com
APP_FRONTEND_URL=http://localhost:5173
# DOMAIN=trina.midominio.com  # solo demo/prod (P-03)
