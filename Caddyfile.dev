# Caddy local sin HTTPS (el dominio y HTTPS llegan con P-03). Sirve la SPA compilada y proxea API/MinIO.
:80

root * /srv
file_server

handle /api/* {
  uri strip_prefix /api
  reverse_proxy api:8080
}

handle /media/* {
  uri strip_prefix /media
  reverse_proxy minio:9000
}

handle /v3/api-docs* {
  reverse_proxy api:8080
}
